generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId         String   @unique
  email            String   @unique
  password         String   // Hashed
  profileFor       String
  fullName         String
  isEmailVerified  Boolean  @default(false)
  verificationOtp  String?
  verificationOtpExpires DateTime?
  
  // Role & Monetization
  role             Role     @default(USER)
  
  // Dual Access Monetization
  availableTokens  Int      @default(0)    // Token based (Quick Access)
  planType         PlanType @default(FREE) // Subscription based
  planExpiry       DateTime?               // Subscription duration
  remainingNumbers Int      @default(0)    // Remaining contacts from Plan
  
  // Progress tracking
  onboardingStep   Int      @default(1)

  // System Flags
  status           UserStatus @default(Active)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // --- Profile Data Relation ---
  profile          Profile?
  
  // --- Relational Records ---
  unlockedProfiles ContactUnlock[] @relation("UnlockedBy")
  unlockedByOthers ContactUnlock[] @relation("TargetProfile")
  
  // --- Shortlisting ---
  shortlists       Shortlist[] @relation("UserShortlists")
  shortlistedBy    Shortlist[] @relation("ShortlistedByOthers")
  
  // --- Interest ---
  interestsSent     Interest[] @relation("SentInterests")
  interestsReceived Interest[] @relation("ReceivedInterests")
  
  // --- Transactions ---
  transactions      Transaction[]

  // --- Messages ---
  messagesSent      Message[] @relation("SentMessages")
  messagesReceived  Message[] @relation("ReceivedMessages")

  // --- Photo Requests ---
  photoRequestsSent     PhotoRequest[] @relation("SentPhotoRequests")
  photoRequestsReceived PhotoRequest[] @relation("ReceivedPhotoRequests")
}

model Transaction {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  user             User     @relation(fields: [userId], references: [id])
  
  amount           Float
  productType      ProductType // TOKEN or SUBSCRIPTION
  packageName      String      // e.g., "5 Tokens" or "Gold (3 Months)"
  senderNumber     String
  trxId            String      @unique
  status           TransactionStatus @default(PENDING)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Message {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  
  senderId     String   @db.ObjectId
  sender       User     @relation("SentMessages", fields: [senderId], references: [id])
  
  receiverId   String   @db.ObjectId
  receiver     User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  content      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Shortlist {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  
  userId           String   @db.ObjectId
  user             User     @relation("UserShortlists", fields: [userId], references: [id])
  
  targetUserId     String   @db.ObjectId
  targetUser       User     @relation("ShortlistedByOthers", fields: [targetUserId], references: [id])

  createdAt        DateTime @default(now())

  @@unique([userId, targetUserId])
}

model Profile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Phase 1: Guardian / Contact Info (LOCKED FROM PUBLIC) ---
  guardianName     String?
  guardianRelation String?
  guardianMobile   String?  // THIS IS THE PAYWALLED DATA
  guardianEmail    String?  // THIS IS THE PAYWALLED DATA

  // --- Phase 2: Basic Identity ---
  gender           String?
  religion         String?
  sect             String?
  motherTongue     String?
  dob              DateTime? // Stored as ISODate
  age              Int?
  maritalStatus    String?
  height           String?
  physicalStatus   String?

  // --- Phase 3: Location & Profession ---
  country          String?
  division         String?
  district         String?
  subDistrict      String?
  state            String?
  citizenship      String?
  highestEducation String?
  employedIn       String?
  occupation       String?
  annualIncome     String?
  bio              String?

  // --- Phase 4: Portraits ---
  // Stored as an array of uploaded image URLs (e.g., Cloudinary/AWS)
  photos           String[] @default([])
  photoVisibility  PhotoVisibility @default(PUBLIC)

  // --- Phase 5: Lifestyle & Lineage ---
  weight           String?
  bodyType         String?
  nativePlace      String?
  fatherOccupation String?
  motherOccupation String?
  brothers         String?
  brothersMarried  String?
  sisters          String?
  sistersMarried   String?
  familyBio        String?
  eatingHabits     String?
  drinkingHabits   String?
  smokingHabits    String?
  interests        String[] @default([])
  favMusic         String[] @default([])
  favSports        String[] @default([])
  favFood          String[] @default([])

  // --- Phase 6: Partner Preferences ---
  partnerAgeMin        Int?
  partnerAgeMax        Int?
  partnerHeightMin     String?
  partnerHeightMax     String?
  partnerMaritalStatus String[] @default([])
  partnerReligions     String?
  partnerEducation     String?
  partnerBio           String?

  // --- Phase 7: Security / NID (Visible only to Admins) ---
  nidFront         String?
  nidBack          String?
  isNidVerified    Boolean @default(false)
  nidStatus        NidStatus @default(NONE)
}

// Tracks which user spent a connection to unlock whose guardian details
model ContactUnlock {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // The user who spent the connection
  unlockedById     String   @db.ObjectId
  unlockedBy       User     @relation("UnlockedBy", fields: [unlockedById], references: [id])

  // The profile they unlocked
  targetUserId     String   @db.ObjectId
  targetUser       User     @relation("TargetProfile", fields: [targetUserId], references: [id])

  unlockedAt       DateTime @default(now())

  // A composite unique constraint ensures a user can only unlock a profile once
  @@unique([unlockedById, targetUserId])
}

model Interest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  
  senderId     String   @db.ObjectId
  sender       User     @relation("SentInterests", fields: [senderId], references: [id])
  
  receiverId   String   @db.ObjectId
  receiver     User     @relation("ReceivedInterests", fields: [receiverId], references: [id])
  
  status       InterestStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([senderId, receiverId])
}

enum UserStatus {
  Active
  Banned
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum PlanType {
  FREE
  GOLD
  DIAMOND
  PLATINUM
}

enum ProductType {
  TOKEN
  SUBSCRIPTION
}

enum TransactionStatus {
  PENDING
  SUCCESS
  REJECTED
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model PhotoRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  
  requesterId  String   @db.ObjectId
  requester    User     @relation("SentPhotoRequests", fields: [requesterId], references: [id])
  
  targetUserId String   @db.ObjectId
  targetUser   User     @relation("ReceivedPhotoRequests", fields: [targetUserId], references: [id])
  
  status       RequestStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([requesterId, targetUserId])
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PhotoVisibility {
  PUBLIC
  PRIVATE
}

enum NidStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}
